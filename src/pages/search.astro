---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = `${import.meta.env.BASE_URL}`.endsWith('/') ? `${import.meta.env.BASE_URL}` : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Search recipes">
  <p class="text-mute">Search now lives on the cookbook home page.</p>
  <p><a href={baseUrl}>Go to cookbook</a></p>

  <script define:vars={{ baseUrl }}>
    const nextUrl = `${baseUrl}${window.location.search}${window.location.hash}`;
    window.location.replace(nextUrl);
  </script>
</BaseLayout>
