---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const withBase = (path) => {
  const base = `${import.meta.env.BASE_URL}`.endsWith('/') ? `${import.meta.env.BASE_URL}` : `${import.meta.env.BASE_URL}/`;
  return `${base}${path}`;
};

const formatCreatedDate = (value) =>
  new Intl.DateTimeFormat('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(new Date(value));

const recipes = (await getCollection('recipes'))
  .map((recipe) => {
    const createdAt = recipe.data.created_at ? new Date(recipe.data.created_at).toISOString() : '';

    return {
      ...recipe,
      slug: recipe.id,
      createdAt,
      createdLabel: createdAt ? formatCreatedDate(createdAt) : 'Recently added',
    };
  })
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const published = recipes.filter((recipe) => recipe.data.status === 'published');
const draftsUrl = withBase('drafts/');
const searchUrl = withBase('search/');
const activeTag = Astro.url.searchParams.get('tag')?.trim().toLowerCase() ?? '';
---
<BaseLayout title="Cookbook">
  <section class="mb-10 border-b border-[color:var(--color-line)] pb-8 sm:mb-14 sm:pb-10">
    <p class="m-0 text-[0.95rem] font-medium text-mute">{published.length} published recipes</p>
    <h2 class="m-0 mt-3 max-w-[13ch] text-[2.15rem] sm:text-[3.4rem]">Cookbook</h2>
    <form class="mt-6 grid gap-3" action={searchUrl} method="get">
      <label class="sr-only" for="recipe-search-entry">Search recipes</label>
      <input
        id="recipe-search-entry"
        class="w-full rounded-[10px] border border-[color:var(--color-line-strong)] bg-panel px-4 py-4 font-inherit text-[1.08rem] text-ink outline-none ring-0 placeholder:text-mute/80 focus:outline-2 focus:outline-offset-2 focus:outline-black"
        type="search"
        name="q"
        placeholder="Search recipes, ingredients, tags…"
        autocomplete="off"
      />
      <div class="flex flex-wrap items-center gap-2.5">
        <button class="inline-flex cursor-pointer items-center justify-center rounded-[10px] border border-transparent bg-accent px-4 py-3 font-inherit text-[0.98rem] font-medium text-white no-underline transition hover:bg-[rgb(0_0_0/0.78)] active:bg-[rgb(0_0_0/0.72)]" type="submit">
          Search
        </button>
        <button id="random-recipe" class="inline-flex cursor-pointer items-center justify-center rounded-[10px] border border-[color:var(--color-line)] bg-panel px-4 py-3 font-inherit text-[0.98rem] font-medium text-ink no-underline transition hover:bg-panel-soft" type="button">
          Random
        </button>
      </div>
    </form>
  </section>

  <section class="mb-8" data-category-section="all">
    <div class="mb-5 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-end">
      <div>
        <h2 class="m-0 text-[1.45rem]">All recipes</h2>
      </div>
      {activeTag && <p class="m-0 text-[0.95rem] text-mute">Filtered by tag: <strong class="font-medium text-ink">{activeTag}</strong></p>}
    </div>

    <div class="grid border-t border-[color:var(--color-line)]">
      {published.map((recipe) => (
        <article
          class="grid gap-2 border-b border-[color:var(--color-line)] py-4 transition hover:bg-panel-soft sm:-mx-3 sm:px-3"
          data-searchable
          data-tags={recipe.data.tags.join(' ').toLowerCase()}
        >
          <h3 class="m-0 text-[1.22rem] sm:text-[1.35rem]">
            <a class="text-inherit no-underline hover:underline" href={withBase(`recipes/${recipe.slug}/`)}>{recipe.data.title}</a>
          </h3>
          {recipe.data.tags.length > 0 && (
            <div class="mt-0 flex flex-wrap gap-1.5">
              {recipe.data.tags.map((tag) => (
                <button class="inline-flex cursor-pointer items-center whitespace-nowrap rounded-[999px] border border-[color:var(--color-line)] bg-transparent px-2.5 py-1 text-[0.72rem] leading-none text-mute no-underline transition hover:bg-panel-soft hover:text-ink data-[active=true]:border-black data-[active=true]:bg-black data-[active=true]:text-white" type="button" data-tag-filter={tag}>
                  {tag}
                </button>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <p class="mt-8 text-[0.95rem] text-mute">
    Looking for rougher notes? <a class="no-underline" href={draftsUrl}>Browse drafts</a>.
  </p>

  <script>
    const input = document.querySelector('#recipe-search-entry');
    const randomButton = document.querySelector('#random-recipe');
    const cards = Array.from(document.querySelectorAll('[data-searchable]'));
    const sections = Array.from(document.querySelectorAll('[data-category-section]'));
    const tagButtons = Array.from(document.querySelectorAll('[data-tag-filter]'));
    const publishedRecipeLinks = Array.from(document.querySelectorAll('article h3 a'));

    const getState = () => {
      const params = new URLSearchParams(window.location.search);
      return {
        tag: (params.get('tag') || '').trim().toLowerCase(),
      };
    };

    const setParams = ({ tag }) => {
      const params = new URLSearchParams(window.location.search);

      if (tag) params.set('tag', tag);
      else params.delete('tag');

      const search = params.toString();
      const nextUrl = `${window.location.pathname}${search ? `?${search}` : ''}${window.location.hash}`;
      window.history.replaceState({}, '', nextUrl);
    };

    const applyFilters = () => {
      const { tag } = getState();

      cards.forEach((card) => {
        const tags = card.dataset.tags || '';
        const matchesTag = !tag || tags.split(/\s+/).includes(tag);
        card.style.display = matchesTag ? '' : 'none';
      });

      sections.forEach((section) => {
        const visibleCards = section.querySelectorAll('article:not([style*="display: none"])');
        section.style.display = visibleCards.length ? '' : 'none';
      });

      tagButtons.forEach((button) => {
        const isActive = (button.dataset.tagFilter || '').toLowerCase() === tag;
        button.dataset.active = isActive ? 'true' : 'false';
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    if (input) {
      input.addEventListener('focus', () => {
        window.location.href = '/cookbook/search/';
      });
    }

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedTag = (button.dataset.tagFilter || '').trim().toLowerCase();
        const currentTag = getState().tag;
        setParams({ tag: currentTag === selectedTag ? '' : selectedTag });
        applyFilters();
      });
    });

    window.addEventListener('popstate', applyFilters);
    applyFilters();

    if (randomButton && publishedRecipeLinks.length) {
      randomButton.addEventListener('click', () => {
        const visibleRecipeLinks = publishedRecipeLinks.filter((link) => link.closest('article')?.style.display !== 'none');
        const pool = visibleRecipeLinks.length ? visibleRecipeLinks : publishedRecipeLinks;
        const pick = pool[Math.floor(Math.random() * pool.length)];
        if (pick?.href) window.location.href = pick.href;
      });
    }
  </script>
</BaseLayout>
